{
  "name": "fieldstack",
  "private": true,
  "version": "0.0.0",
  "devDependencies": {
    "@types/node": "^22.18.2",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  },
  "scripts": {
    "dev": "trap 'kill 0' INT TERM; pnpm --filter api dev & pnpm --filter web dev & wait",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm build:web && pnpm build:api && pnpm postbuild",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "postbuild": "node scripts/copy-frontend.js",
    "start": "cd apps/api && node dist/index.js",
    "test": "pnpm --recursive test",
    "lint": "pnpm --recursive lint",
    "typecheck": "pnpm --recursive typecheck",
    "format": "pnpm --recursive format",
    "storybook": "pnpm --filter @fieldstack/controls storybook"
  }
}
