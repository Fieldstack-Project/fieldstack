# ── Server ───────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ─────────────────────────────────────────────────
# PostgreSQL (default) — docker-compose.yml 기준 기본값
DB_PROVIDER=postgres
DATABASE_URL=postgresql://fieldstack:fieldstack@localhost:5432/fieldstack

# SQLite (경량 단독 인스턴스용)
# DB_PROVIDER=sqlite
# SQLITE_PATH=./data/database.db

# ── Auth ─────────────────────────────────────────────────────
# 프로덕션에서 반드시 32자 이상의 랜덤 문자열로 교체
# JWT_SECRET=change-me-to-a-random-32-char-secret
# JWT_REFRESH_SECRET=change-me-to-another-random-secret
TOTP_ISSUER=Fieldstack

# ── Shared Link ───────────────────────────────────────────────
# 공유 링크 활성화 조건: 도메인 연결 필요 (IP/localhost 시 비활성화)
# PUBLIC_URL=https://myapp.example.com
